
# Shell scripts and systemd units are deployed to a Linux host verbatim.
# A CRLF checkout on Windows makes them unrunnable there ("$: command not
# found", "syntax error near unexpected token $do").
ops/runner/*.sh text eol=lf
ops/runner/*.service text eol=lf
ops/runner/*.timer text eol=lf
# Copied into a Linux image as-is (ops/mirror/Dockerfile).
ops/mirror/*.sh text eol=lf
ops/mirror/nginx.conf text eol=lf
ops/mirror/Dockerfile text eol=lf
