[req]
distinguished_name = dn
prompt = no
x509_extensions = v3_ca
[dn]
O = System-B90
OU = Development
CN = System-B90 Dev Root CA
[v3_ca]
basicConstraints = critical,CA:TRUE,pathlen:0
keyUsage = critical,keyCertSign,cRLSign
subjectKeyIdentifier = hash
nameConstraints = critical,@nc
[nc]
permitted;DNS.1 = localhost
permitted;DNS.2 = .localhost
permitted;DNS.3 = .test
permitted;DNS.4 = .internal
permitted;DNS.5 = .local
permitted;DNS.6 = bluz.dev
permitted;DNS.7 = .bluz.dev
permitted;IP.1 = 127.0.0.0/255.0.0.0
permitted;IP.2 = 10.0.0.0/255.0.0.0
permitted;IP.3 = 172.16.0.0/255.240.0.0
permitted;IP.4 = 192.168.0.0/255.255.0.0
permitted;IP.5 = ::1/ffff:ffff:ffff:ffff:ffff:ffff:ffff:ffff
